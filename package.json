{
  "name": "omega-agent",
  "version": "1.0.0",
  "description": "A local-first framework for building and running AI agents.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "OMega": "bin/om.js",
    "om": "bin/om.js"
  },
  "files": [
    "dist/",
    "bin/",
    "skills/",
    "om.config.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.public.json",
    "prepare": "npm run build",
    "start": "node bin/om.js",
    "init": "node bin/om.js init",
    "gateway": "node bin/om.js gateway",
    "test": "npm run build && node --test tests/*.test.js",
    "test:e2e": "npm run build && node tests/e2e_ui.test.mjs",
    "benchmark": "npm run build && node --test tests/benchmark.test.js",
    "benchmark:eval": "npm run build && node scripts/run-benchmark.js",
    "check:types": "tsc --noEmit && tsc -p tsconfig.public.json --noEmit",
    "docs:check": "node scripts/sync-docs.js --check",
    "docs:sync": "node scripts/sync-docs.js --write",
    "lint": "oxlint --deny-warnings src",
    "format": "prettier --write \"src/**/*.ts\" \"*.md\""
  },
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "omega-agent",
    "tools",
    "skills",
    "llm",
    "vector-search",
    "multi-model",
    "local-first",
    "framework"
  ],
  "author": "Saad Abbas <saadeddine.abbas@bau.edu.lb>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code10/OMega.git"
  },
  "bugs": {
    "url": "https://github.com/code10/OMega/issues"
  },
  "homepage": "https://github.com/code10/OMega#readme",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxlint": "^1.94.0",
    "playwright": "^1.65.1",
    "prettier": "^3.10.1",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "onnxruntime-node": "^1.31.1"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2"
  }
}
