# ============================================================================
# OMega (omega-harness) — Secure Environment Configuration Template
# Copy this file to .env and fill in the API keys for the providers you use.
# Zero API keys are required to run local models (LM Studio, vLLM, or OM)!
# ============================================================================

# Active LLM Provider: auto | gemini | openai | anthropic | deepseek | kimi | qwen | glm | lmstudio | vllm | om
OM_PROVIDER=auto

# Optional default model override
# OM_MODEL=gemini-3.5-flash

# Cloud Provider API Keys (Never commit your actual .env file to version control!)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# Local Model Server Endpoints (Optional)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
VLLM_BASE_URL=http://127.0.0.1:8000/v1
# LOCAL_MODEL_PATH=/path/to/huggingface-safetensors-model
# LOCAL_MODELS_DIR=/path/to/directory-containing-model-folders

# Web Gateway Server Settings
OM_GATEWAY_PORT=3000

# Optional True Semantic Embeddings (OpenAI-compatible /v1/embeddings or Ollama /api/embed)
# OM_EMBEDDING_URL=http://127.0.0.1:11434/api/embed
# OM_EMBEDDING_MODEL=nomic-embed-text
# OM_EMBEDDING_API_KEY=

# Optional LLM-Summarized History Compaction (true | false)
# OM_LLM_COMPACTION=true
